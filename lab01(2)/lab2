def task2():
    """
    Задача 2: 216^6+216^4+36^6-6^14-24 в системе с основанием 6. Сколько различных цифр?
    
    >>> task2()
    4
    """
    val = 216**6 + 216**4 + 36**6 - 6**14 - 24
    digits = set()
    while val > 0:
        digits.add(val % 6)
        val //= 6
    return len(digits)

def task3():
    """
    Задача 3: числа до 10^9 по маске 12345??8, делящиеся на 23
    """
    results = []
    for x in range (0, 10**9, 23):
        if fnmatch(str(x), '12345?7?8'):
            results.append ((x, x // 23))
        if len(results) ==5:
            break
    return results

