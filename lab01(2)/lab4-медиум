from functools import wraps

def type_and_range_check_fixed(expected_type, min_val=None, max_val=None):
    def decorator(func):
        @wraps(func)
        def wrapper(*args, **kwargs):
            for arg in args:
                # Проверка типа
                if not isinstance(arg, expected_type):
                    # Получаем имя типа для сообщения об ошибке
                    if isinstance(expected_type, tuple):
                        # Если expected_type - кортеж, перечисляем все допустимые типы
                        type_names = ', '.join(t.__name__ for t in expected_type)
                        expected_msg = f"один из ({type_names})"
                    else:
                        # Если один тип - просто его имя
                        expected_msg = expected_type.__name__
                    
                    raise TypeError(
                        f"Ожидался {expected_msg}, получен {type(arg).__name__}"
                    )
                
                # Проверка на минимальное значение
                if min_val is not None and arg < min_val:
                    raise ValueError(f"Значение {arg} < {min_val}")
                
                # Проверка на максимальное значение
                if max_val is not None and arg > max_val:
                    raise ValueError(f"Значение {arg} > {max_val}")
            
            return func(*args, **kwargs)
        
        return wrapper
    return decorator
