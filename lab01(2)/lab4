    print(f"\nФинальное среднее: {avg()}")
    print(f"Проверка: (10+20+30+40+50)/5 = {sum(numbers_to_test)/len(numbers_to_test)}")
    
    # ЧАСТЬ 2: Декоратор
    print("\n" + "=" * 60)
    print("【 ЧАСТЬ 2: ДЕКОРАТОР ПРОВЕРКИ АРГУМЕНТОВ 】")
    
    print("\n✓ Успешные вызовы:")
    print(f"   safe_add(50, 30) = {safe_add(50, 30)}")
    print(f"   safe_add(10.5, 20.3) = {safe_add(10.5, 20.3)}")
    print(f"   safe_multiply(5, 3) = {safe_multiply(5, 3)}")
    
    print("\n✗ Вызовы с ошибками (перехвачены исключения):")
    
