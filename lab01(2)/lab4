def test_average_closure():
    avg = make_average()
    assert avg(10) == 10.0
    assert avg(20) == 15.0
    assert avg(30) == 20.0
    assert avg() == 20.0

def test_average_empty():
    avg = make_average()
    assert avg() == 0

def test_average_single():
    avg = make_average()
    assert avg(42) == 42.0
    assert avg() == 42.0

def test_decorator_success():
    @validate_args(type_check=int, min_value=0, max_value=100)
    def test_func(x):
        return x * 2
    assert test_func(50) == 100
    assert test_func(0) == 0
    assert test_func(100) == 200

def test_decorator_type_error():
    @validate_args(type_check=int)
    def test_func(x):
        return x
    try:
        test_func(3.14)
        assert False
    except TypeError:
        pass

def test_decorator_min_error():
    @validate_args(min_value=0)
    def test_func(x):
        return x
    try:
        test_func(-5)
        assert False
    except ValueError:
        pass

def test_decorator_max_error():
    @validate_args(max_value=100)
    def test_func(x):
        return x
    try:
        test_func(200)
        assert False
    except ValueError:
        pass



