# ========== ТЕСТЫ ДЛЯ PYTEST ==========

def test_linearize():
    test_input = [1, 2, [3, 4, [5, [6]]]]
    expected = [1, 2, 3, 4, 5, 6]
    assert linearize_recursive(test_input) == expected
    assert linearize_iterative(test_input) == expected

def test_linearize_empty():
    assert linearize_recursive([]) == []
    assert linearize_iterative([]) == []

def test_linearize_simple():
    test_input = [1, 2, 3]
    expected = [1, 2, 3]
    assert linearize_recursive(test_input) == expected
    assert linearize_iterative(test_input) == expected

def test_ab_k0():
    assert rec_ab(0, 1, 1) == (1, 1)
    assert iter_ab(0, 1, 1) == (1, 1)

def test_ab_k1():
    assert rec_ab(1, 1, 1) == (3, 3)
    assert iter_ab(1, 1, 1) == (3, 3)

def test_ab_k2():
    assert rec_ab(2, 1, 1) == (9, 9)
    assert iter_ab(2, 1, 1) == (9, 9)

def test_ab_different():
    assert rec_ab(1, 0, 1) == (2, 1)
    assert iter_ab(1, 0, 1) == (2, 1)

