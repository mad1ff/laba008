import pytest
from task8 import (
    linearize_recursive,
    linearize_iterative,
    calculate_ab_recursive,
    calculate_ab_iterative
)

# ------------------------------------------------------------
# Тесты для линеаризации
# ------------------------------------------------------------

def test_linearize_simple():
    data = [1, [2, 3], 4]
    expected = [1, 2, 3, 4]
    assert linearize_recursive(data) == expected
    assert linearize_iterative(data) == expected

def test_linearize_deep_nesting():
    data = [1, [2, [3, [4, [5]]]]]
    expected = [1, 2, 3, 4, 5]
    assert linearize_recursive(data) == expected
    assert linearize_iterative(data) == expected

def test_linearize_empty():
    assert linearize_recursive([]) == []
    assert linearize_iterative([]) == []

def test_linearize_no_nesting():
    data = [1, 2, 3, 4, 5]
    expected = [1, 2, 3, 4, 5]
    assert linearize_recursive(data) == expected
    assert linearize_iterative(data) == expected

def test_linearize_with_empty_sublist():
    data = [1, [], [2, [], 3], 4]
    expected = [1, 2, 3, 4]
    assert linearize_recursive(data) == expected
    assert linearize_iterative(data) == expected

# ------------------------------------------------------------
# Тесты для расчёта a_k, b_k
# ------------------------------------------------------------

@pytest.mark.parametrize("k, a0, b0, expected", [
    (0, 1, 1, (1, 1)),
    (1, 1, 1, (3, 3)),
    (2, 1, 1, (9, 9)),
    (3, 1, 1, (27, 27)),
    (0, 2, 3, (2, 3)),
    (1, 2, 3, (8, 7)),
    (2, 2, 3, (22, 23)),
])
def test_calculate_ab(k, a0, b0, expected):
    # Сравниваем рекурсивную и итеративную версии
    rec_result = calculate_ab_recursive(k, a0, b0)
    it_result = calculate_ab_iterative(k, a0, b0)
    assert rec_result == expected
    assert it_result == expected
    # Также проверяем, что обе версии совпадают
    assert rec_result == it_result


