# ========== ЗАДАЧА 1: ЛИНЕАРИЗАЦИЯ СПИСКОВ ==========

# Рекурсивный вариант
def linearize_recursive(lst):
    result = []
    for item in lst:
        if isinstance(item, list):
            result.extend(linearize_recursive(item))
        else:
            result.append(item)
    return result

# Итеративный вариант (без рекурсии) - ОКОНЧАТЕЛЬНО ИСПРАВЛЕН
def linearize_iterative(lst):
    result = []
    stack = list(lst)  # создаём копию списка
    while stack:
        item = stack.pop(0)  # берём первый элемент
        if isinstance(item, list):
            # вставляем элементы списка в начало
            stack = item + stack
        else:
            result.append(item)
    return result

# ========== ЗАДАЧА 2: РАСЧЁТ a_k И b_k ==========

# Рекурсивный вариант
def rec_ab(k, a0, b0):
    if k == 0:
        return a0, b0
    a_prev, b_prev = rec_ab(k - 1, a0, b0)
    a_k = 2 * b_prev + a_prev
    b_k = 2 * a_prev + b_prev
    return a_k, b_k

# Итеративный вариант (без рекурсии)
def iter_ab(k, a0, b0):
    a, b = a0, b0
    for _ in range(k):
        a, b = 2 * b + a, 2 * a + b
    return a, b

# ========== ДЕМОНСТРАЦИЯ РАБОТЫ ==========

if __name__ == "__main__":
    print("=" * 60)
