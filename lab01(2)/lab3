1. Линеаризация вложенных списков
2. Расчёт a_k, b_k по рекуррентным формулам
"""

from typing import List, Union, Tuple

# ------------------------------------------------------------
# Часть 1: Линеаризация списка
# ------------------------------------------------------------

def linearize_recursive(nested_list: List[Union[int, List]]) -> List[int]:
    """
    Линеаризация вложенного списка с помощью рекурсии.
    
    Пример:
    >>> linearize_recursive([1, 2, [3, 4, [5, [6]]], 2, 3, 4, 5, 6])
    [1, 2, 3, 4, 5, 6, 2, 3, 4, 5, 6]
    """
    result = []
    for element in nested_list:
        if isinstance(element, list):
            result.extend(linearize_recursive(element))
        else:
            result.append(element)
    return result


def linearize_iterative(nested_list: List[Union[int, List]]) -> List[int]:
    """
    Линеаризация вложенного списка без рекурсии (через стек).
    
    Пример:
    >>> linearize_iterative([1, 2, [3, 4, [5, [6]]], 2, 3, 4, 5, 6])
    [1, 2, 3, 4, 5, 6, 2, 3, 4, 5, 6]
    """
    stack = [nested_list]
    result = []
    while stack:
        current = stack.pop()
        if isinstance(current, list):
            # добавляем элементы в обратном порядке для сохранения порядка
            for item in reversed(current):
                stack.append(item)
        else:
            result.append(current)
    return result


# ------------------------------------------------------------
# Часть 2: Расчёт a_k и b_k
# ------------------------------------------------------------

def calculate_ab_recursive(k: int, a0: float, b0: float) -> Tuple[float, float]:
    """
    Рекурсивный расчёт a_k, b_k по формулам:
    a_k = 2*b_{k-1} + a_{k-1}
    b_k = 2*a_{k-1} + b_{k-1}
    
    Возвращает (a_k, b_k)
    """
    if k == 0:
        return a0, b0
    a_prev, b_prev = calculate_ab_recursive(k - 1, a0, b0)
    a_k = 2 * b_prev + a_prev
    b_k = 2 * a_prev + b_prev
    return a_k, b_k


def calculate_ab_iterative(k: int, a0: float, b0: float) -> Tuple[float, float]:
    """
    Итеративный расчёт a_k, b_k.
    """
    a, b = a0, b0
    for _ in range(k):
        a_next = 2 * b + a
        b_next = 2 * a + b
        a, b = a_next, b_next
    return a, b


# ------------------------------------------------------------
# Пример использования (для демонстрации)
# ------------------------------------------------------------
if __name__ == "__main__":
    print("=== Линеаризация списков ===")
    data = [1, 2, [3, 4, [5, [6]]], 2, 3, 4, 5, 6]
    print("Исходный:", data)
    print("Рекурсия:", linearize_recursive(data))
    print("Итеративно:", linearize_iterative(data))
    
    print("\n=== Расчёт a_k, b_k ===")
    a0, b0 = 1, 1
    for k in range(5):
        a_rec, b_rec = calculate_ab_recursive(k, a0, b0)
        a_it, b_it = calculate_ab_iterative(k, a0, b0)
        print(f"k={k}: рекурсия ({a_rec}, {b_rec}) | итеративно ({a_it}, {b_it})")






