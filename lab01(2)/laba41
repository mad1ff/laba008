def make_average():
    """
    Замыкание для вычисления среднего арифметического всех переданных аргументов.
    """
    numbers = []
    
    def average(value=None):
        if value is not None:
            numbers.append(value)
        
        if not numbers:
            return 0
        
        return sum(numbers) / len(numbers)
    
    return average


