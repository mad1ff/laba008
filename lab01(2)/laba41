# ЧАСТЬ 2: ДЕКОРАТОРЫ (Medium + Новый декоратор)
# ============================================================

def log_args(func):
    """
    Декоратор для вывода всех аргументов функции в консоль.
    Выводит позиционные (*args) и именованные (**kwargs) аргументы.
    """
    def wrapper(*args, **kwargs):
        print(f"\n[LOG] Вызов функции: {func.__name__}")
        
        # Вывод позиционных аргументов
        if args:
            print(f"  Позиционные аргументы (*args): {args}")
        else:
            print(f"  Позиционные аргументы (*args): отсутствуют")
        
        # Вывод именованных аргументов
        if kwargs:
            print(f"  Именованные аргументы (**kwargs): {kwargs}")
        else:
            print(f"  Именованные аргументы (**kwargs): отсутствуют")
        
        # Вызов оригинальной функции
        result = func(*args, **kwargs)
        print(f"  Результат: {result}")
        
        return result
    
    return wrapper


def validate_args(type_check=None, min_value=None, max_value=None):
    """
    Декоратор для проверки аргументов функции на тип и диапазон значений.
    """
    def decorator(func):
        def wrapper(*args, **kwargs):
            # Проверяем позиционные аргументы
            for i, arg in enumerate(args):
                if type_check is not None and not isinstance(arg, type_check):
                    raise TypeError(f"Аргумент {i} должен быть типа {type_check.__name__}, получен {type(arg).__name__}")
                
                if min_value is not None and arg < min_value:
                    raise ValueError(f"Аргумент {i} = {arg} меньше минимального значения {min_value}")
                
                if max_value is not None and arg > max_value:
                    raise ValueError(f"Аргумент {i} = {arg} больше максимального значения {max_value}")
            
            # Проверяем именованные аргументы
            for key, arg in kwargs.items():
                if type_check is not None and not isinstance(arg, type_check):
                    raise TypeError(f"Аргумент {key} должен быть типа {type_check.__name__}, получен {type(arg).__name__}")
                
                if min_value is not None and arg < min_value:
                    raise ValueError(f"Аргумент {key} = {arg} меньше минимального значения {min_value}")
                
                if max_value is not None and arg > max_value:
                    raise ValueError(f"Аргумент {key} = {arg} больше максимального значения {max_value}")
            
            return func(*args, **kwargs)
        
        return wrapper
    return decorator


# ============================================================
# ПРИМЕР ИСПОЛЬЗОВАНИЯ
# ============================================================

# Вешаем оба декоратора: сначала validate_args (проверка), потом log_args (логирование)
# Важен порядок: сначала применяется нижний декоратор (log_args), потом верхний (validate_args)
@log_args
@validate_args(type_check=(int, float), min_value=-100, max_value=100)
def safe_add(a, b):
    """Функция с проверкой аргументов и логированием"""
    return a + b

@validate_args(type_check=int, min_value=0, max_value=10)
def safe_multiply(a, b):
    return a * b


