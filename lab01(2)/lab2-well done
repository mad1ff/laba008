import re
import fnmatch

# ============================================================
# Класс для задачи 1: комбинаторика
# ============================================================
class CombinatoricsCounter:
    """
    Класс для подсчёта количества последовательностей с фиксированными
    первым и последним символами.
    """
    def __init__(self, alphabet, length, first_char, last_char):
        self.alphabet = alphabet
        self.length = length
        self.first_char = first_char
        self.last_char = last_char

    def count_sequences(self):
        """Возвращает количество возможных последовательностей."""
        if self.length < 2:
            return 0
        free_positions = self.length - 2
        return len(self.alphabet) ** free_positions


# ============================================================
# Класс для задачи 2: системы счисления
# ============================================================
class BaseConverter:
    """
    Класс для подсчёта различных цифр в записи числа в системе счисления.
    """
    def __init__(self, expression, base):
        self.expression = expression
        self.base = base

    def evaluate(self):
        """Вычисляет значение арифметического выражения."""
        return eval(self.expression)

    def count_unique_digits(self):
        """Возвращает количество различных цифр в записи числа в системе base."""
        value = self.evaluate()
        if value == 0:
            return 1
        digits = set()
        temp = abs(value)
        while temp > 0:
            digits.add(temp % self.base)
            temp //= self.base
        return len(digits)


# ============================================================
# Класс для задачи 3: поиск по маске и делимости
# ============================================================
class MaskDivisibleFinder:
    """
    Класс для поиска чисел, соответствующих маске и делящихся на заданное число.
    """
    def __init__(self, mask, divisor, max_value):
        self.mask = mask
        self.divisor = divisor
        self.max_value = max_value
        # Преобразуем маску fnmatch в регулярное выражение
        self.regex = fnmatch.translate(mask)
        self.pattern = re.compile(self.regex)

    def matches_mask(self, num_str):
        """Проверяет, соответствует ли строка числа маске."""
        return bool(self.pattern.fullmatch(num_str))

    def find_numbers(self):
        """
        Находит все числа от 1 до max_value, которые:
        1) соответствуют маске
        2) делятся на divisor
        Возвращает список кортежей (число, число // divisor).
        """
        results = []
        for num in range(self.divisor, self.max_value + 1, self.divisor):
            if self.matches_mask(str(num)):
                results.append((num, num // self.divisor))
        return results


